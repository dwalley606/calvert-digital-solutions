# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored; this file is committed as the source of truth.

# ── Public (exposed to the browser) ────────────────────────────────────────────

# Canonical site URL — no trailing slash
NEXT_PUBLIC_SITE_URL=https://calvertdigitalsolutions.com

# HubSpot meeting embed/link URL
NEXT_PUBLIC_HUBSPOT_MEETING_URL=https://meetings-na2.hubspot.com/daniel-walley

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server-only ─────────────────────────────────────────────────────────────────
# Add server-side secrets here (API keys, etc.) — never prefix with NEXT_PUBLIC_

# Resend — for the contact form API route (src/app/api/contact/route.ts)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# HubSpot private app token — creates a CRM contact on form submission
# Create a private app at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here
